# Application
APP_ENV=DEV
FLASK_HOST=0.0.0.0
FLASK_PORT=8000
FLASK_DEBUG=false

# Local MongoDB
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_NAME=caifubao
MONGODB_USER=caifubao
MONGODB_PASS=change-me-local-only

# Backend security
# Use strong random values outside local development.
SECRET_KEY=change-me-local-secret
JWT_SECRET_KEY=change-me-local-jwt-secret
SECURITY_PASSWORD_SALT=change-me-local-password-salt
SECURITY_PASSWORD_HASH=sha256_crypt

# Optional notifications
SMTP_SENDER_EMAIL=
SMTP_SENDER_PASSWORD=
BARK_URL=

# Datahub
DATAHUB_STARTUP_CATCHUP_ENABLED=true
LOG_LEVEL=INFO
LOG_FORMAT=json
HEALTH_CHECK_LOG_ENABLED=false

# Frontend
# When true, the score experiment page uses built-in mock data and does not call backend APIs.
VITE_USE_MOCK_API=false
