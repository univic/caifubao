#!/usr/bin/env bash
# ============================================================================
# caifubao — Unified CLI for Caifubao platform operations
#
# Usage:
#   scripts/caifubao <command> [options]
#   make <command>              # convenience shortcuts
#
# Commands:
#   data
#     sync                  Sync data from prod to dev MongoDB
#     refresh-status        Refresh data_asset_status freshness
#     status STOCK          Check data completeness for a stock
#
#   score
#     score-one STOCK       Score a single stock
#     score-all [DATE]      Score all active stocks
#     verify [DATE]         Verify pending score predictions
#     report [DATE]         Generate calibration report
#
#   system
#     health                Check all MongoDB connections
#     cron SUBCOMMAND       Manage dev CronJobs (status/list/trigger)
#     pod                   Print current datahub pod name
#
#   dev (local only)
#     dev                   Start backend + frontend dev servers
#     lint                  Run ruff + pytest on datahub
#
# Environment:
#   KUBECONFIG              Path to k3s.yaml (default: /etc/rancher/k3s/k3s.yaml)
#   CFB_NAMESPACE           K8s namespace (default: caifubao-dev)
#
# Examples:
#   scripts/caifubao data sync
#   scripts/caifubao score score-one sz000977 --date 2026-05-18 --horizon 5
#   scripts/caifubao data status sz000977
#   scripts/caifubao system health
# ============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# ---- Defaults ----
KUBECONFIG="${KUBECONFIG:-/etc/rancher/k3s/k3s.yaml}"
CFB_NAMESPACE="${CFB_NAMESPACE:-caifubao-dev}"
CFB_POD_LABEL="${CFB_POD_LABEL:-app=caifubao-datahub}"
PYTHON_BIN="${PYTHON_BIN:-python}"

# ---- Colors ----
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'

# ---- Helpers ----
die() { echo -e "${RED}ERROR:${NC} $*" >&2; exit 1; }
info() { echo -e "${GREEN}→${NC} $*"; }
warn() { echo -e "${YELLOW}⚠${NC} $*"; }

_kubectl() {
  KUBECONFIG="$KUBECONFIG" kubectl "$@"
}

_pod_name() {
  _kubectl -n "$CFB_NAMESPACE" get pods -l "$CFB_POD_LABEL" \
    -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || \
    die "No datahub pod found in namespace $CFB_NAMESPACE"
}

_pod_exec() {
  local pod
  pod="$(_pod_name)"
  _kubectl -n "$CFB_NAMESPACE" exec "$pod" -- "$@"
}

_pod_exec_json() {
  _pod_exec "$@" 2>&1 | grep -E '^\{|^\[' | head -1
}

# ---- Data commands ----

cmd_data_sync() {
  local from_date="${1:-}"
  local collections="${2:-quote,factor,signal,market,industry}"
  local args=()
  [[ -n "$from_date" ]] && args+=(--from-date "$from_date")
  args+=(--collections "$collections")
  info "Syncing $collections from prod to dev..."
  if [[ -n "$from_date" ]]; then
    info "  from: $from_date"
  fi
  _pod_exec "$PYTHON_BIN" -m app.jobs.data_sync_runner run "${args[@]}"
}

cmd_data_refresh_status() {
  local limit="${1:-10000}"
  info "Refreshing data_asset_status (limit=$limit stocks)..."
  _pod_exec "$PYTHON_BIN" -m app.jobs.data_asset_status_initializer --limit "$limit"
}

cmd_data_status() {
  local stock="${1:-}"
  if [[ -z "$stock" ]]; then
    die "Usage: caifubao data status <STOCK_CODE>"
  fi
  info "Checking data status for $stock..."
  _pod_exec python3 -c "
from pymongo import MongoClient
import os, datetime, json
c = MongoClient(host=os.environ['MONGODB_HOST'], port=int(os.environ['MONGODB_PORT']),
    username=os.environ['MONGODB_USER'], password=os.environ['MONGODB_PASS'], authSource='admin')
db = c[os.environ['MONGODB_NAME']]

result = {'stock': '$stock', 'collections': {}}
for coll, code_f, date_f in [
    ('stock_daily_quote', 'code', 'date'),
    ('stock_factor_daily', 'stock_code', 'date'),
    ('stock_signal_daily', 'stock_code', 'date'),
    ('stock_score_predictions', 'stock_code', 'date'),
]:
    if coll in db.list_collection_names():
        cnt = db[coll].count_documents({code_f: '$stock'})
        latest = list(db[coll].find({code_f: '$stock'}).sort(date_f, -1).limit(1))
        lt = str(latest[0][date_f])[:10] if latest and date_f in latest[0] else 'N/A'
        result['collections'][coll] = {'count': cnt, 'latest': lt}
    else:
        result['collections'][coll] = {'count': 0, 'latest': 'NOT_FOUND'}

# Get active status
stock_doc = list(db.basic_stock.find({'code': '$stock'}).limit(1))
if stock_doc:
    s = stock_doc[0]
    result['name'] = s.get('name', '?')
    result['active_status'] = s.get('active_status', '?')

print(json.dumps(result, indent=2, ensure_ascii=False, default=str))
"
}

# ---- Score commands ----

cmd_score_one() {
  local stock="${1:-}"; shift || true
  local date="" horizon="" replace=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --date) date="$2"; shift 2 ;;
      --horizon) horizon="$2"; shift 2 ;;
      --replace) replace="--replace"; shift ;;
      *) shift ;;
    esac
  done
  [[ -z "$stock" ]] && die "Usage: caifubao score score-one <STOCK> [--date YYYY-MM-DD] [--horizon 5] [--replace]"
  date="${date:-$(python3 -c 'import datetime;print(datetime.date.today().isoformat())')}"
  horizon="${horizon:-5}"

  info "Scoring $stock for $date (horizon=$horizon)..."
  _pod_exec "$PYTHON_BIN" -m app.jobs.scoring_runner backfill \
    --from "$date" --to "$date" --horizon "$horizon" \
    --stock-code "$stock" --replace
}

cmd_score_all() {
  local date="${1:-$(python3 -c 'import datetime;print(datetime.date.today().isoformat())')}"
  local horizon="${2:-5}"
  info "Scoring ALL stocks for $date (horizon=$horizon)..."
  _pod_exec "$PYTHON_BIN" -m app.jobs.scoring_runner backfill \
    --from "$date" --to "$date" --horizon "$horizon" --replace
}

cmd_score_verify() {
  local from="${1:-}"; local to="${2:-}"; local horizon="${3:-5}"
  from="${from:-$(python3 -c 'import datetime;print((datetime.date.today()-datetime.timedelta(days=7)).isoformat())')}"
  to="${to:-$(python3 -c 'import datetime;print(datetime.date.today().isoformat())')}"
  info "Verifying predictions $from → $to (horizon=$horizon)..."
  _pod_exec "$PYTHON_BIN" -m app.jobs.scoring_runner verify \
    --from "$from" --to "$to" --horizon "$horizon"
}

cmd_score_report() {
  local from="${1:-}"; local to="${2:-}"; local horizon="${3:-5}"
  from="${from:-$(python3 -c 'import datetime;print((datetime.date.today()-datetime.timedelta(days=30)).isoformat())')}"
  to="${to:-$(python3 -c 'import datetime;print(datetime.date.today().isoformat())')}"
  info "Generating calibration report $from → $to (horizon=$horizon)..."
  _pod_exec "$PYTHON_BIN" -m app.jobs.scoring_runner report \
    --from "$from" --to "$to" --horizon "$horizon" --format json
}

# ---- System commands ----

cmd_system_health() {
  info "Checking Caifubao dev environment health..."
  echo ""

  # K3s connection
  echo "=== K3s Connection ==="
  if _kubectl get ns "$CFB_NAMESPACE" &>/dev/null; then
    echo "  K3s: ✓ connected (namespace: $CFB_NAMESPACE)"
  else
    warn "  K3s: ✗ cannot reach namespace $CFB_NAMESPACE"
    return 1
  fi

  # Pod status
  local pod
  pod="$(_pod_name 2>/dev/null)" || { warn "  Datahub pod: ✗ not found"; return 1; }
  local pod_status
  pod_status="$(_kubectl -n "$CFB_NAMESPACE" get pod "$pod" -o jsonpath='{.status.phase}')"
  echo "  Pod ($pod): $pod_status"

  # MongoDB connections
  echo ""
  echo "=== MongoDB Connections ==="
  _pod_exec python3 -c "
from pymongo import MongoClient
import os

# Local MongoDB
try:
    c = MongoClient(host=os.environ['MONGODB_HOST'], port=int(os.environ['MONGODB_PORT']),
        username=os.environ['MONGODB_USER'], password=os.environ['MONGODB_PASS'],
        authSource='admin', serverSelectionTimeoutMS=5000)
    c.admin.command('ping')
    db = c[os.environ['MONGODB_NAME']]
    qcnt = db.stock_daily_quote.estimated_document_count() if 'stock_daily_quote' in db.list_collection_names() else 0
    print(f'  LOCAL  ✓ {os.environ[\"MONGODB_NAME\"]} (~{qcnt} quotes)')
except Exception as e:
    print(f'  LOCAL  ✗ {e}')

# SRC MongoDB
if os.environ.get('MONGODB_SRC_HOST'):
    try:
        c2 = MongoClient(host=os.environ['MONGODB_SRC_HOST'], port=int(os.environ.get('MONGODB_SRC_PORT', 27017)),
            username=os.environ.get('MONGODB_SRC_USER',''), password=os.environ.get('MONGODB_SRC_PASS',''),
            authSource='admin', serverSelectionTimeoutMS=5000)
        c2.admin.command('ping')
        db2 = c2[os.environ['MONGODB_SRC_NAME']]
        qcnt2 = db2.stock_daily_quote.estimated_document_count() if 'stock_daily_quote' in db2.list_collection_names() else 0
        print(f'  SRC    ✓ {os.environ[\"MONGODB_SRC_NAME\"]} (~{qcnt2} quotes)')
    except Exception as e:
        print(f'  SRC    ✗ {e}')
else:
    print('  SRC    - not configured')
" 2>/dev/null

  # CronJobs
  echo ""
  echo "=== CronJobs ==="
  _kubectl -n "$CFB_NAMESPACE" get cronjobs -o custom-columns='NAME:.metadata.name,SCHEDULE:.spec.schedule,SUSPEND:.spec.suspend' 2>/dev/null

  # Data summary
  echo ""
  echo "=== Data ==="
  _pod_exec python3 -c "
from pymongo import MongoClient
import os
c = MongoClient(host=os.environ['MONGODB_HOST'], port=int(os.environ['MONGODB_PORT']),
    username=os.environ['MONGODB_USER'], password=os.environ['MONGODB_PASS'], authSource='admin')
db = c[os.environ['MONGODB_NAME']]
for coll in ['stock_daily_quote','stock_factor_daily','stock_signal_daily','stock_score_predictions']:
    if coll in db.list_collection_names():
        est = db[coll].estimated_document_count()
        print(f'  {coll:35s} ~{est}')
    else:
        print(f'  {coll:35s} NOT FOUND')
" 2>/dev/null
}

cmd_system_cron() {
  local sub="${1:-status}"
  case "$sub" in
    status|list)
      _kubectl -n "$CFB_NAMESPACE" get cronjobs
      ;;
    trigger)
      local job="${2:-}"
      [[ -z "$job" ]] && die "Usage: caifubao system cron trigger <cronjob-name>"
      local job_name="trigger-$(date +%s)"
      info "Triggering CronJob $job → $job_name..."
      _kubectl -n "$CFB_NAMESPACE" create job --from="cronjob/$job" "$job_name"
      ;;
    suspend)
      local job="${2:-}"; [[ -z "$job" ]] && die "Usage: caifubao system cron suspend <cronjob-name>"
      _kubectl -n "$CFB_NAMESPACE" patch cronjob "$job" -p '{"spec":{"suspend":true}}'
      info "Suspended $job"
      ;;
    resume)
      local job="${2:-}"; [[ -z "$job" ]] && die "Usage: caifubao system cron resume <cronjob-name>"
      _kubectl -n "$CFB_NAMESPACE" patch cronjob "$job" -p '{"spec":{"suspend":false}}'
      info "Resumed $job"
      ;;
    *)
      die "Unknown cron subcommand: $sub (use: status|trigger|suspend|resume)"
      ;;
  esac
}

cmd_system_pod() {
  _pod_name
}

# ---- Dev commands ----

cmd_dev() {
  info "Starting backend + frontend dev servers..."
  "$ROOT_DIR/scripts/dev.sh" "${1:-.env.local}"
}

cmd_dev_lint() {
  info "Linting datahub..."
  cd "$ROOT_DIR"
  ruff check datahub/ || true
  ruff format --check datahub/ || true
  info "Running datahub tests..."
  cd datahub && python -m pytest app/test/ -x --tb=short 2>/dev/null || warn "Some tests failed (may need MongoDB)"
}

# ---- Main ----

usage() {
  cat <<'EOF'
caifubao — Caifubao Platform CLI

Usage:
  scripts/caifubao <domain> <command> [options]

Data:
  data sync [FROM_DATE] [COLLECTIONS]  Sync data from prod to dev
  data refresh-status [LIMIT]          Refresh data_asset_status freshness
  data status <STOCK>                  Check data completeness for a stock

Score:
  score score-one <STOCK> [opts]      Score a single stock (--date --horizon --replace)
                                      Note: --replace is always applied (idempotent)
  score score-all [DATE] [HORIZON]    Score all active stocks
  score verify [FROM] [TO] [HORIZON]  Verify pending predictions
  score report [FROM] [TO] [HORIZON]  Generate calibration report

System:
  system health                       Full environment health check
  system cron [status|trigger|suspend|resume] <name>
                                      Manage dev CronJobs
  system pod                          Print current datahub pod name

Dev (local):
  dev                                 Start backend + frontend
  lint                                Ruff + pytest on datahub

Environment:
  KUBECONFIG        Path to k3s.yaml (default: /etc/rancher/k3s/k3s.yaml)
  CFB_NAMESPACE     K8s namespace (default: caifubao-dev)

Examples:
  caifubao data sync
  caifubao score score-one sz000977
  caifubao data status sz000977
  caifubao system health
EOF
}

main() {
  local domain="${1:-}"; shift || true
  case "$domain" in
    data)
      local cmd="${1:-}"; shift || true
      case "$cmd" in
        sync)           cmd_data_sync "$@" ;;
        refresh-status) cmd_data_refresh_status "$@" ;;
        status)         cmd_data_status "$@" ;;
        *)              die "Unknown data command: $cmd (use: sync|refresh-status|status)" ;;
      esac
      ;;
    score)
      local cmd="${1:-}"; shift || true
      case "$cmd" in
        score-one)      cmd_score_one "$@" ;;
        score-all)      cmd_score_all "$@" ;;
        verify)         cmd_score_verify "$@" ;;
        report)         cmd_score_report "$@" ;;
        *)              die "Unknown score command: $cmd (use: score-one|score-all|verify|report)" ;;
      esac
      ;;
    system)
      local cmd="${1:-}"; shift || true
      case "$cmd" in
        health)         cmd_system_health ;;
        cron)           cmd_system_cron "$@" ;;
        pod)            cmd_system_pod ;;
        *)              die "Unknown system command: $cmd (use: health|cron|pod)" ;;
      esac
      ;;
    dev)
      local cmd="${1:-}"; shift || true
      case "$cmd" in
        ""|dev)         cmd_dev "$@" ;;
        lint)           cmd_dev_lint "$@" ;;
        *)              die "Unknown dev command: $cmd (use: dev|lint)" ;;
      esac
      ;;
    -h|--help|"")
      usage
      ;;
    *)
      die "Unknown domain: $domain (use: data|score|system|dev)"
      ;;
  esac
}

main "$@"
