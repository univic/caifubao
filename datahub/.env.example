# Datahub runtime
APP_ENV=DEV
DATAHUB_STARTUP_CATCHUP_ENABLED=true

# MongoDB (local)
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_NAME=caifubao
MONGODB_USER=caifubao
MONGODB_PASS=change-me-local-only

# Stock history provider. AkShare uses HTTPS and is the production-safe default.
# Set to baostock only when outbound TCP access to www.baostock.com:10030 works.
DATAHUB_STOCK_HISTORY_SOURCE=akshare

# MongoDB source (for prod→dev data sync via sync_engine)
# Only needed when running data_sync_runner to pull data from prod.
MONGODB_SRC_HOST=localhost
MONGODB_SRC_PORT=27017
MONGODB_SRC_NAME=caifubao
MONGODB_SRC_USER=readonly_user
MONGODB_SRC_PASS=change-me-local-only

# Logging
LOG_LEVEL=INFO
PYMONGO_LOG_LEVEL=INFO
LOG_FORMAT=json
HEALTH_CHECK_LOG_ENABLED=false
PROGRESS_LOG_ENABLED=false

# Optional notifications
SMTP_SENDER_EMAIL=
SMTP_SENDER_PASSWORD=
BARK_URL=
